# 복사해서 .env로 사용한다 (.env는 Git에 올리지 않는다).
# 아래 값은 로컬 개발용 기본값이며 비밀값이 아니다. 배포 환경에서는 secret manager를 사용한다.

# PostgreSQL (docker-compose.yml)
STAYOPS_DB_NAME=stayops
STAYOPS_DB_USER=stayops
STAYOPS_DB_PASSWORD=stayops
STAYOPS_DB_PORT=5432

# API (apps/api, application.yml)
STAYOPS_DB_URL=jdbc:postgresql://localhost:5432/stayops
STAYOPS_API_PORT=8080
